(function(){
  const OLD = document.getElementById("tlkio-host");
  if (OLD) OLD.remove();

  let autoHide = false, visible = true, destroyed = false;

  const host = document.createElement("div");
  host.id = "tlkio-host";
  host.style.all = "initial";
  host.style.position = "fixed";
  host.style.top = "0";
  host.style.left = "0";
  host.style.zIndex = "2147483647";
  document.documentElement.appendChild(host);

  const shadow = host.attachShadow({mode:"open"});
  const wrap = document.createElement("div");
  wrap.style.all = "initial";
  wrap.style.pointerEvents = "auto";
  shadow.appendChild(wrap);

  const css = document.createElement("style");
  css.textContent = `
    .chat { width:340px; height:400px; position:fixed; bottom:14px; left:14px;
           background:#000; border-radius:10px; border:1px solid rgba(255,255,255,0.04);
           overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,0.6); }
    .iframe { width:100%; height:100%; border:0; display:block; }
    .gear { position:fixed; bottom:14px; right:14px; width:36px; height:36px;
           border-radius:50%; background:#222; color:#fff; display:flex;align-items:center;
           justify-content:center; cursor:pointer; box-shadow:0 6px 18px rgba(0,0,0,0.45); }
    .settings { position:fixed; bottom:68px; right:14px; width:280px; background:#0f1113;
               color:#dfefff; border-radius:10px; padding:12px; box-shadow:0 12px 30px rgba(0,0,0,0.5);
               display:none; font-size:13px; line-height:1.45; }
    .row{margin-bottom:12px}
    .label{display:block;margin-bottom:6px;color:#cfe6ff;font-weight:600}
    .help{display:none;background:#071018;padding:10px;border-radius:8px;color:#bfe6ff;font-family:monospace;font-size:13px;white-space:pre-wrap}
    .close{float:right;cursor:pointer;color:#9fb0c8;font-weight:700}
    input[type=range]{width:100%}
    .controls{display:flex;align-items:center;gap:10px}
    .hint{color:#9fb0c8;font-size:12px;margin-top:6px}
  `;
  wrap.appendChild(css);

  const chat = document.createElement("div");
  chat.className = "chat";
  chat.id = "tlkio";
  const iframe = document.createElement("iframe");
  iframe.className = "iframe";
  iframe.src = atob("aHR0cHM6Ly9lbWJlZC50bGsuaW8vTW9pc3RCaXNjdWl0cz90aGVtZT10aGVtZS0tZGF5");
  chat.appendChild(iframe);
  wrap.appendChild(chat);

  const gear = document.createElement("div");
  gear.className = "gear";
  gear.id = "chatGearBtn";
  gear.textContent = "⚙";
  wrap.appendChild(gear);

  const settings = document.createElement("div");
  settings.className = "settings";
  settings.id = "chatSettings";
  settings.innerHTML = `
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
      <div style="font-weight:700;font-size:14px">Settings</div>
      <div class="close" id="closeSettings">✕</div>
    </div>

    <div class="row">
      <div class="label">Opacity</div>
      <input id="chatOpacity" type="range" min="20" max="100" value="100">
    </div>

    <div class="row controls">
      <input id="autoHide" type="checkbox"><label for="autoHide" style="cursor:pointer">Auto-hide on leave</label>
    </div>

    <div class="row controls">
      <div id="helpToggle" style="cursor:pointer;padding:6px;border-radius:6px;background:rgba(255,255,255,0.02);font-weight:700">?</div>
      <div class="hint">CTRL+SHIFT+E toggle · ESC remove</div>
    </div>

    <div class="help" id="commands">
Bold = __Bold__
Italic = _Italic_
Code = &#96;code&#96;
Strike = ~~Strike~~
List item = * Item
Quote = &gt; Quote
Horizontal rule = ---
Link = [Title](https://example.com)
Image = ![Title](image.png)
    </div>
  `;
  wrap.appendChild(settings);

  const $ = sel => shadow.querySelector(sel);

  const openSettings = () => { if (destroyed) return; settings.style.display = "block"; };
  const closeSettings = () => { if (destroyed) return; settings.style.display = "none"; $("#commands").style.display = "none"; };

  gear.addEventListener("click", (e)=>{ if (destroyed) return; const d = getComputedStyle(settings).display; if (d==="none") openSettings(); else closeSettings(); e.stopPropagation(); });
  $("#closeSettings").addEventListener("click", (e)=>{ closeSettings(); e.stopPropagation(); });

  document.addEventListener("click", (ev)=>{ if (destroyed) return; const p = ev.composedPath ? ev.composedPath() : []; if (!p.includes(settings) && !p.includes(gear)) closeSettings(); });

  $("#helpToggle").addEventListener("click", (e)=>{ const h = $("#commands"); h.style.display = (getComputedStyle(h).display==="none") ? "block" : "none"; e.stopPropagation(); });

  $("#chatOpacity").addEventListener("input", (e)=>{ if (destroyed) return; chat.style.opacity = (e.target.value/100).toString(); });
  $("#autoHide").addEventListener("change", (e)=>{ autoHide = !!e.target.checked; });

  const onVis = ()=>{ if (destroyed) return; if (autoHide && document.visibilityState==="hidden"){ visible=false; chat.style.display="none"; settings.style.display="none"; gear.style.display="none"; } };
  document.addEventListener("visibilitychange", onVis);

  const onKey = (e)=>{ if (destroyed) return;
    if (e.ctrlKey && e.shiftKey && e.key.toLowerCase()==="e"){ visible = !visible; if (visible){ chat.style.display="block"; gear.style.display="flex"; } else { chat.style.display="none"; settings.style.display="none"; gear.style.display="none"; } return; }
    if (e.key==="Escape"){ destroy(); }
  };
  document.addEventListener("keydown", onKey);

  const observer = new MutationObserver(()=>{ if (destroyed) return; iframe.style.width="100%"; iframe.style.height="100%"; });
  observer.observe(chat, { attributes:true, attributeFilter:["style"] });

  function destroy(){ if (destroyed) return; destroyed=true;
    try{ document.removeEventListener("visibilitychange", onVis); document.removeEventListener("keydown", onKey); document.removeEventListener("click", ()=>{}); observer.disconnect(); }catch(e){}
    host.remove();
  }
  host.__destroy = destroy;

  try{ $("#chatOpacity").value = Math.round(parseFloat(getComputedStyle(chat).opacity)*100).toString(); }catch(e){ $("#chatOpacity").value="100"; }
})();
